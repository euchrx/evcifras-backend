generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  EDITOR
  USER
}

enum SongStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum AudioTrackType {
  ORIGINAL
  PLAYBACK
  GUIDE
  LESSON
  DEMO
  OTHER
}

enum AudioTrackStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  active       Boolean  @default(true)

  favorites    Favorite[]
  repertoires  Repertoire[]
  createdSongs Song[]       @relation("SongCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Artist {
  id        String  @id @default(uuid())
  name      String
  slug      String  @unique
  imageUrl  String?
  bio       String?
  mainGenre String?
  active    Boolean @default(true)

  songs Song[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Song {
  id          String     @id @default(uuid())
  title       String
  slug        String
  lyrics      String
  chords      String
  originalKey String?
  currentKey  String?
  capo        String?
  genre       String?
  difficulty  Difficulty @default(BEGINNER)
  status      SongStatus @default(DRAFT)
  youtubeUrl  String?
  views       Int        @default(0)

  artistId String
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Restrict)

  createdById String?
  createdBy   User?   @relation("SongCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  favorites       Favorite[]
  repertoireItems RepertoireItem[]
  audioTracks     AudioTrack[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([artistId, slug])
  @@index([title])
  @@index([slug])
  @@index([status])
  @@index([genre])
}

model Favorite {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  songId String
  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, songId])
  @@index([userId])
  @@index([songId])
}

model Repertoire {
  id          String  @id @default(uuid())
  name        String
  description String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items RepertoireItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model RepertoireItem {
  id       String @id @default(uuid())
  position Int    @default(0)

  repertoireId String
  repertoire   Repertoire @relation(fields: [repertoireId], references: [id], onDelete: Cascade)

  songId String
  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([repertoireId, songId])
  @@index([repertoireId])
  @@index([songId])
}

model AudioTrack {
  id          String           @id @default(uuid())
  title       String
  description String?
  type        AudioTrackType   @default(OTHER)
  status      AudioTrackStatus @default(DRAFT)

  audioUrl    String
  durationSec Int?
  sizeBytes   Int?
  mimeType    String?

  songId String
  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([songId])
  @@index([status])
  @@index([type])
}
